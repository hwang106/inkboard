{
  "name": "inkboard-rooms",
  "private": true,
  "type": "module",
  "description": "Live collaboration rooms for InkBoard (Cloudflare Worker + Durable Objects)",
  "scripts": {
    "vendor": "esbuild vendor-entry.js --bundle --format=esm --minify --outfile=../app/vendor/yjs.mjs",
    "test": "node test/room.test.mjs",
    "dev": "wrangler dev --port 8790",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "lib0": "0.2.114",
    "y-protocols": "1.0.6",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "wrangler": "4.160.0"
  }
}
